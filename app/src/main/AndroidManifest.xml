<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for network state and WiFi info -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Required for historical and per-app network stats -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Needed to resolve arbitrary per-UID usage records to installed app names/icons on Android 11+.
         Keep for the sideload build's full app-attribution feature; Google Play requires a declaration
         and approval for this broad visibility permission. See docs/PLAY_STORE_POLICY.md. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- For widgets and background updates -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <permission
        android:name="com.wifitracker.app.permission.READ_WIFI_USAGE"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WifiTracker"
        tools:targetApi="35">

        <receiver
            android:name=".networkusage.WifiNetworkUsageBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".networkusage.WifiNetworkUsageService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started local Wi-Fi usage sampling" />
        </service>
        <provider
            android:name=".networkusage.WifiNetworkUsageProvider"
            android:authorities="com.wifitracker.app.networkusage"
            android:exported="true"
            android:readPermission="com.wifitracker.app.permission.READ_WIFI_USAGE"
            android:writePermission="com.wifitracker.app.permission.READ_WIFI_USAGE" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WifiTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widgets -->
        <receiver
            android:name=".widget.DailyUsageWidgetReceiver"
            android:exported="true"
            android:label="Daily WiFi Usage">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_usage_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WeeklyUsageWidgetReceiver"
            android:exported="true"
            android:label="Weekly WiFi Usage">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weekly_usage_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.MonthlyUsageWidgetReceiver"
            android:exported="true"
            android:label="Monthly WiFi Usage">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/monthly_usage_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.LiveSpeedWidgetReceiver"
            android:exported="true"
            android:label="Live WiFi Speed">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/live_speed_widget_info" />
        </receiver>

    </application>
</manifest>
